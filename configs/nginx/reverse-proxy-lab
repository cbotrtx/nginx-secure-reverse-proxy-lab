# Day 2 lab: HTTPS reverse proxy, loopback only

upstream app1_backend { server 127.0.0.1:8081; }
upstream app2_backend { server 127.0.0.1:8082; }

# Port 80: redirect only, never serve content in plain text
server {
    listen 127.0.0.1:80;
    listen [::1]:80;
    server_name app1.lab.test app2.lab.test;
    return 301 https://$host$request_uri;
}

server {
    listen 127.0.0.1:443 ssl;
    listen [::1]:443 ssl;
    http2 on;
    server_name app1.lab.test;
    include snippets/tls-lab.conf;
include snippets/security-headers.conf;
limit_req zone=lab_req burst=20 nodelay;
limit_conn lab_conn 20;
access_log /var/log/nginx/lab-access.log lab_security;

    location / {
        proxy_pass http://app1_backend;
        include snippets/proxy-headers.conf;
    }
}

server {
    listen 127.0.0.1:443 ssl;
    listen [::1]:443 ssl;
    http2 on;
    server_name app2.lab.test;
    include snippets/tls-lab.conf;
include snippets/security-headers.conf;
limit_req zone=lab_req burst=20 nodelay;
limit_conn lab_conn 20;
access_log /var/log/nginx/lab-access.log lab_security;
include snippets/admin-acl.conf;

    location / {
        proxy_pass http://app2_backend;
        include snippets/proxy-headers.conf;
    }
}
